  "captions": [
    {
      "start": 0,
      "end": 8.115,
      "text": "Small print, repeated facts, and too much typing can make paperwork exhausting. Unbound Access takes one question at a time.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 8.44,
      "end": 15.89,
      "text": "Large controls and read aloud support spoken or typed answers. The person reviews every change and keeps control of the record.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 16.2,
      "end": 24.869999999999997,
      "text": "This edited walkthrough uses actual app screens, fictional typed data, and generic synthetic narration. It is not continuous voice capture.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 25.2,
      "end": 32.265,
      "text": "An answer is only a proposal. Cancel leaves saved answers unchanged. Confirm moves to the next question.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 32.6,
      "end": 38.96,
      "text": "The prepared form says household size must be one through twelve. Thirteen is rejected before it can be saved.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 39.28,
      "end": 46.655,
      "text": "Two is accepted. Zero dollars is also a valid income answer, rather than being mistaken for a missing value.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 46.96,
      "end": 54.14,
      "text": "Answer Yes to access support and the required follow up appears. Here the fictional request is questions read aloud.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 54.44,
      "end": 61.714999999999996,
      "text": "Now correct the home address from forty to forty one Practice Street. The app shows both linked fields and their previous values.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 62.04,
      "end": 70.63,
      "text": "Confirmation updates both home answers together. The separate landlord address stays ninety Venue Lane. Shared facts do not cross different people.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 70.96,
      "end": 78.76499999999999,
      "text": "Review the source linked answers, acknowledge the review, and download the PDF. Persistent Save and Open links allow another attempt.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 79.08,
      "end": 86.38499999999999,
      "text": "These are both pages of the actual browser downloaded file. The corrected addresses and zero income survived export and were checked.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 86.72,
      "end": 93.205,
      "text": "This is a readable answer record, not a filled original agency form. Nothing is signed or submitted.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 93.52,
      "end": 102.44999999999999,
      "text": "Built with Llama. Optional Meta Llama three point two, one billion parameters, runs genuine inference inside the browser through w llama.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 102.75999999999999,
      "end": 112.07,
      "text": "The revised development run correctly interpreted three clear answers: three people, zero dollars, and No. Its unchanged raw outputs are preserved.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 112.39999999999999,
      "end": 119.25999999999999,
      "text": "It also guessed three when the input was uncertain. The current source guard rejects that guess. This is not a model success.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 119.55999999999999,
      "end": 130.515,
      "text": "Question extraction failed required flag validation. General extraction remains experimental and unreliable. Prepared forms and direct controls remain available.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 130.83999999999997,
      "end": 139.74499999999998,
      "text": "The optional model download is about eight hundred eight megabytes, with explicit consent and removal controls. CPU inference is slow.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 140.07999999999998,
      "end": 148.33499999999998,
      "text": "No API key, card, or paid fallback is needed. Local model tasks stay in the browser; browser speech may use a remote service.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 148.64,
      "end": 156.92999999999998,
      "text": "Eighty six automated checks passed. The complete typed browser journey and downloaded PDF were verified separately from model quality.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 157.23999999999998,
      "end": 167.73499999999999,
      "text": "One tester reported phone audio, microphone, and sample PDF opening. Full phone dictation, timed usability, and GPU offload remain unverified.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 168.04,
      "end": 176.105,
      "text": "Try the working form, inspect real inference receipts, and read the public source. Every confirmed answer remains yours to review.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    }
  ],
