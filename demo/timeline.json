  "captions": [
    {
      "start": 0,
      "end": 4.84,
      "text": "Paperwork can mean small text, repeated facts, and too much typing.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 5.16,
      "end": 10.11,
      "text": "Unbound Access guides one question at a time, with spoken or typed answers.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 10.440000000000001,
      "end": 16.48,
      "text": "This edited walkthrough uses actual app screens and fictional typed answers, with synthetic narration.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 16.8,
      "end": 21.84,
      "text": "For a new form, choose the clearly labelled, reviewed Meta workshop example.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 22.16,
      "end": 28.89,
      "text": "Meta Muse Glimmer returned nine questions in the public playground. The original proposal failed validation.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 29.2,
      "end": 34.765,
      "text": "Seven fact keys were empty, and one help sentence added an unsupported legal name requirement.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 35.08,
      "end": 40.37,
      "text": "The saved example documents those eight corrections. It is not an unchanged model output.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 40.68,
      "end": 47.34,
      "text": "The app checks source quotes, pages, constraints, and shared facts before asking for your approval.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 47.64,
      "end": 53.745000000000005,
      "text": "Loading this captured example makes no new model call. You approve the questions before starting.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 54.08,
      "end": 58.464999999999996,
      "text": "Type or speak an answer. Check the proposed value before confirming it.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 58.8,
      "end": 64.36,
      "text": "The source allows zero to four companions. Five is rejected, while zero is accepted.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 64.67999999999999,
      "end": 69.99,
      "text": "Answering yes to communication support reveals the required follow up question.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 70.32,
      "end": 74.235,
      "text": "Now change the home address from forty to forty one Practice Street.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 74.55999999999999,
      "end": 79.29499999999999,
      "text": "Before saving, the app shows both linked home questions and their previous values.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 79.6,
      "end": 85.17999999999999,
      "text": "After confirmation, both home answers match. The separate venue address stays unchanged.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 85.47999999999999,
      "end": 91.00999999999999,
      "text": "Review every answer and check the review box. Incomplete answers produce a labelled draft.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 91.32,
      "end": 96.76499999999999,
      "text": "The reviewed answer record is ready, with persistent Save PDF and Open PDF links.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 97.08,
      "end": 103.19,
      "text": "This page was generated by the same app PDF exporter, using these nine fictional answers.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 103.52,
      "end": 109.14,
      "text": "It is a readable answer record. It does not fill or submit the original agency form.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 109.44,
      "end": 116.91499999999999,
      "text": "Seventy nine automated checks passed. One tester reported working phone sound, microphone, and saved PDF opening.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 117.24,
      "end": 122.975,
      "text": "That was a basic device check, not a timed usability study or a complete dictated journey.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 123.28,
      "end": 129.225,
      "text": "The automatic Meta API has no key configured. Live server inference and answer mapping remain untested.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    },
    {
      "start": 129.56,
      "end": 134.83,
      "text": "Try the app and inspect the complete source package. You control every confirmed answer.",
      "mode": "subtitle",
      "timing": "measured full synthesized phrase; no independent transcript alignment"
    }
  ],
